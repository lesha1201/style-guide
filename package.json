{
  "name": "@alexey-ryabov/style-guide",
  "version": "1.0.0-canary.3",
  "description": "Alexey Ryabov's style guide",
  "homepage": "https://github.com/lesha1201/style-guide#readme",
  "bugs": {
    "url": "https://github.com/lesha1201/style-guide/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lesha1201/style-guide.git"
  },
  "files": [
    "dist",
    "typescript"
  ],
  "type": "module",
  "main": "index.js",
  "exports": {
    "./eslint/*": {
      "types": "./dist/eslint/configs/*.d.ts",
      "default": "./dist/eslint/configs/*.js"
    },
    "./eslint/utils": {
      "types": "./dist/eslint/utils.d.ts",
      "default": "./dist/eslint/utils.js"
    },
    "./oxlint/*": {
      "types": "./dist/oxlint/configs/*.d.ts",
      "default": "./dist/oxlint/configs/*.js"
    },
    "./oxfmt/*": {
      "types": "./dist/oxfmt/*.d.ts",
      "default": "./dist/oxfmt/*.js"
    },
    "./typescript": "./typescript/tsconfig.base.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint",
    "prepare": "husky",
    "prepublishOnly": "pnpm build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.1",
    "@eslint-react/eslint-plugin": "^4.2.3",
    "@eslint/compat": "^2.0.3",
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-storybook": "^10.3.4",
    "eslint-plugin-tsdoc": "^0.5.2",
    "globals": "^17.4.0",
    "typescript-eslint": "^8.58.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@commitlint/types": "^20.5.0",
    "@semantic-release/git": "^10.0.1",
    "@types/node": "^24.12.2",
    "eslint": "^10.1.0",
    "husky": "^9.1.7",
    "oxfmt": "^0.44.0",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^0.19.0",
    "semantic-release": "^25.0.3",
    "typescript": "^6.0.2"
  },
  "peerDependencies": {
    "eslint": ">=9.0.0 <11",
    "oxfmt": ">=0.44.0 <1",
    "oxlint": ">=1.57.0 <2",
    "typescript": ">=5.0.0 <7"
  },
  "peerDependenciesMeta": {
    "@next/eslint-plugin-next": {
      "optional": true
    },
    "eslint": {
      "optional": true
    },
    "oxlint": {
      "optional": true
    },
    "prettier": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "packageManager": "pnpm@10.33.0"
}
