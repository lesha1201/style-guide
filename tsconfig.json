{
  "extends": "./typescript/tsconfig.base.json",
  "compilerOptions": {
    "incremental": false,
    "target": "ESNext",
    "module": "NodeNext",
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "moduleResolution": "NodeNext",
    "declaration": true,
    "outDir": "dist",
    "types": ["node"]
  },
  "exclude": ["node_modules", "dist"],
  "include": ["eslint", "oxlint", "oxfmt"]
}
